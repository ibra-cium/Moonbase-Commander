    "M1": {
      "briefing": [
        {
          "title": {
            "en": "Welcome, Cadet!",
            "bn": ""
          },
          "text": {
            "en": "Your crew of 4 needs air, water and food every day. Everything must come with you on the lander.",
            "bn": ""
          },
          "fact_id": null
        },
        {
          "title": {
            "en": "Real NASA fact",
            "bn": ""
          },
          "text": null,
          "fact_id": "F05"
        }
      ],
      "question": {
        "text": {
          "en": "How much water does ONE astronaut use in a day?",
          "bn": ""
        },
        "options": [
          {
            "en": "About 1 glass",
            "bn": ""
          },
          {
            "en": "About 3 big bottles",
            "bn": ""
          },
          {
            "en": "About 30 big bottles",
            "bn": ""
          }
        ],
        "correct": 1,
        "explain": {
          "en": "About {WATER_KG_PERSON_DAY|1} kg a day – that's about three 1-litre bottles for each astronaut!",
          "bn": ""
        },
        "constant_ids": [
          "WATER_KG_PERSON_DAY"
        ]
      },
      "lesson": {
        "en": "Astronauts need air, water and food every single day – and all of it must fit on the lander.",
        "bn": ""
      },
      "nasa_now_fact": "F27"
    },
    "M2": {
      "briefing": [
        {
          "title": {
            "en": "Machines can break",
            "bn": ""
          },
          "text": {
            "en": "Even on the Moon, machines break. When one does, send an astronaut to Repair it – fast!",
            "bn": ""
          },
          "fact_id": null
        },
        {
          "title": {
            "en": "Real NASA fact",
            "bn": ""
          },
          "text": null,
          "fact_id": "F22"
        }
      ],
      "question": {
        "text": {
          "en": "On the space station, how much of their water do astronauts get back by recycling?",
          "bn": ""
        },
        "options": [
          {
            "en": "About 10%",
            "bn": ""
          },
          {
            "en": "About half",
            "bn": ""
          },
          {
            "en": "About 98%",
            "bn": ""
          }
        ],
        "correct": 2,
        "explain": {
          "en": "About {WATER_RECOVERY_FULL|pct}! Even sweat and urine are cleaned into drinking water.",
          "bn": ""
        },
        "constant_ids": [
          "WATER_RECOVERY_FULL"
        ]
      },
      "lesson": {
        "en": "Recycling water saves a lot of weight. Fix broken machines fast!",
        "bn": ""
      },
      "nasa_now_fact": "F28"
    },
    "M3": {
      "briefing": [
        {
          "title": {
            "en": "Storm warning",
            "bn": ""
          },
          "text": null,
          "fact_id": "F11"
        },
        {
          "title": {
            "en": "Build a safe shelter",
            "bn": ""
          },
          "text": {
            "en": "Before the storm comes, pack shield water or send crew to Dig Moon soil over the shelter.",
            "bn": ""
          },
          "fact_id": null
        }
      ],
      "question": {
        "text": {
          "en": "What is good at blocking dangerous storm radiation?",
          "bn": ""
        },
        "options": [
          {
            "en": "Bright lights",
            "bn": ""
          },
          {
            "en": "Cold air",
            "bn": ""
          },
          {
            "en": "Water and Moon soil",
            "bn": ""
          }
        ],
        "correct": 2,
        "explain": {
          "en": "Water and Moon soil! 15 g/cm² of water cuts the storm dose from {SPE_DOSE_HABITAT_NO_EXTRA_MSV|0} to about {SPE_DOSE_SHIELD_15|0} mSv.",
          "bn": ""
        },
        "constant_ids": [
          "SPE_DOSE_SHIELD_15",
          "SPE_DOSE_HABITAT_NO_EXTRA_MSV"
        ]
      },
      "lesson": {
        "en": "Water and Moon soil block radiation. Hide in the shelter when a solar storm comes.",
        "bn": ""
      },
      "nasa_now_fact": "F24"
    },
    "M4": {
      "briefing": [
        {
          "title": {
            "en": "The big test",
            "bn": ""
          },
          "text": {
            "en": "Your base must survive the long Moon night. Solar panels make no power in the dark.",
            "bn": ""
          },
          "fact_id": null
        },
        {
          "title": {
            "en": "Real NASA fact",
            "bn": ""
          },
          "text": null,
          "fact_id": "F02"
        }
      ],
      "question": {
        "text": {
          "en": "How long is one night on the Moon?",
          "bn": ""
        },
        "options": [
          {
            "en": "About 12 hours",
            "bn": ""
          },
          {
            "en": "About 2 weeks",
            "bn": ""
          },
          {
            "en": "About 1 year",
            "bn": ""
          }
        ],
        "correct": 1,
        "explain": {
          "en": "About 2 weeks! For our base, batteries for the whole night would weigh about {NIGHT_BATTERY_MASS_KG|k} kg – but the lander carries only {CARGO_LIMIT_KG|k} kg.",
          "bn": ""
        },
        "constant_ids": [
          "NIGHT_DAYS",
          "NIGHT_BATTERY_MASS_KG",
          "CARGO_LIMIT_KG"
        ]
      },
      "lesson": {
        "en": "The Moon night lasts about 2 weeks. Solar panels stop and batteries are too heavy – a small reactor keeps the base alive.",
        "bn": ""
      },
      "nasa_now_fact": "F25"
    }
