[connection signal="pressed" from="CanvasLayer/Panel/VBoxContainer/HBoxCargo/BtnS08" to="." method="_on_btn_s08_pressed"]
[connection signal="pressed" from="CanvasLayer/Panel/VBoxContainer/HBoxCargo/BtnScale" to="." method="_on_btn_toggle_scale_pressed"]
[connection signal="pressed" from="CanvasLayer/Panel/VBoxContainer/HBoxStep/BtnStep" to="." method="_on_btn_step_pressed"]
[connection signal="pressed" from="CanvasLayer/Panel/VBoxContainer/HBoxStep/BtnDay16" to="." method="_on_btn_day16_pressed"]
